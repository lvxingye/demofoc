---
CompileFlags:
  CompilationDatabase: ../build
  Remove:
    - "-mlongcalls"
    - "-fno-shrink-wrap"
    - "-fstrict-volatile-bitfields"
    - "-fno-tree-switch-conversion"
    - "-fzero-init-padding-bits=all"
    - "-fno-malloc-dce"
  Add:
    - "-isystem/home/lvxy/.espressif/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/picolibc/include"
    - "-isystem/home/lvxy/.espressif/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/xtensa-esp-elf/include/c++/15.2.0"
    - "-I/data/source/foc"
    - "-std=c++20"
    
Diagnostics:
  UnusedIncludes: None
  Suppress:
    - "modernize-use-using"
  
InlayHints:
  Enabled: false

Hover:
  ShowAKA: true
